{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backfire-relay",
  "main": "worker.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "ADMISSION", "class_name": "Admission" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Admission"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "null,http://localhost:8080,http://127.0.0.1:8080",
    "ROOM_TTL_SECONDS": "86400"
  }
}
